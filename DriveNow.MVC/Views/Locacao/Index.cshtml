@model IEnumerable<DriveNow.MVC.Models.LocacaoView>

<h2>Lista Locações</h2>

<a asp-action="CriarLocacao" class="btn btn-primary mb-3">Nova Locação</a>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Data de Retirada</th>
            <th>Data de Devolução</th>
            <th>Cliente</th>
            <th>Veículo</th>
            <th>Valor da Locação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.DataRetirada</td>
                <td>@l.DataDevolucao</td>
                <td>@l.NomeCliente</td>
                <td>@l.NomeVeiculo</td>
                <td>@l.ValorTotal</td>
                <td>
                    <a href="/Locacoes/EditarLocacao/@l.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a href="/Locacoes/DeletarLocacao/@l.Id" class="btn btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>