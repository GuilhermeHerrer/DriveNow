@model DriveNow.MVC.Models.VeiculoView

<h1>Cadastro de Veículos</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="CriarVeiculo" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Placa" class="form-label"></label>
                <input asp-for="Placa" class="form-control" />
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorDiaria" class="form-label"></label>
                <input asp-for="ValorDiaria" class="form-control" />
                <span asp-validation-for="ValorDiaria" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AgenciaId" class="form-label"></label>
                <input asp-for="AgenciaId" class="form-control" />
                <span asp-validation-for="AgenciaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FotoUpload" class="form-label">Foto</label>
                <input asp-for="FotoUpload" type="file" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>